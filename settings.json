{
  // ==================== Core Editor & Behavior ====================
  "editor.fontFamily": "Geist Mono, JetBrains Mono, Fira Code",
  "editor.fontSize": 16,
  "editor.fontWeight": "bold",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.lineHeight": 32,
  "editor.tabCompletion": "on",
  "editor.mouseWheelZoom": true,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": false,
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.matchBrackets": "never",
  "editor.colorDecorators": false,
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "inline"
  },
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.guides.indentation": false,
  "editor.minimap.enabled": false,
  "editor.minimap.maxColumn": 250,
  "editor.padding.top": 16,
  "editor.showUnused": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.linkedEditing": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",

  // ==================== User Interface & Experience ====================
  "workbench.activityBar.location": "hidden",
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": false,
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.tree.indent": 15,
  "workbench.tree.enableStickyScroll": false,
  "workbench.colorTheme": "React Theme",
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.files.color": "#42a5f5",
  "material-icon-theme.saturation": 0,
  "workbench.tips.enabled": false,
  "breadcrumbs.enabled": false,
  "scm.diffDecorations": "none",
  "problems.decorations.enabled": false,
  "explorer.sortOrder": "type",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.wordWrap": "on",
  "notebook.output.wordWrap": true,

  // ==================== File & Workspace ====================
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 100,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.associations": {
    ".php_cs": "php",
    ".php_cs.dist": "php"
  },
  "search.useIgnoreFiles": false,
  "search.smartCase": true,
  "search.exclude": {
    "**/vendor/{[^l],?[^ai]}*": true,
    "**/public/{[^i],?[^n]}*": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/_ide_helper.php": true,
    "**/composer.lock": true,
    "**/package-lock.json": true,
    "storage": true,
    ".phpunit.result.cache": true
  },

  // ==================== Languages & Extensions ====================
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "apility.beautify-blade",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  "python.defaultInterpreterPath": "/bin/python3",
  "python.analysis.completeFunctionParens": true,
  "python.analysis.inlayHints.callArgumentNames": "all",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "php.suggest.basic": false,
  "emmet.preferences": {},
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "blade": "html",
    "vue-html": "html",
    "vue": "html",
    "react": "html",
    "javascript": "html"
  },
  "prettier.bracketSameLine": true,
  "prettier.printWidth": 128,
  "prettier.tabWidth": 4,
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,
  "tailwindCSS.includeLanguages": {
    "plaintext": "html"
  },
  "tailwindCSS.experimental.configFile": null,
  "headwind.runOnSave": false,
  "headwind.prependCustomClasses": true,

  // ==================== Git & Version Control ====================
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.autorefresh": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",

  // ==================== Terminal ====================
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.fontSize": 16,

  // ==================== Code Runner ====================
  "code-runner.clearPreviousOutput": true,
  "code-runner.saveFileBeforeRun": true,

  // ==================== Chat & AI Features (Cleaned & Updated) ====================
  // Note: Many chat.agent.* settings from your original file have been deprecated or renamed in recent VS Code versions.
  // The settings below reflect currently relevant configurations.
  "inlineChat.holdToSpeech": false,
  "inlineChat.lineNaturalLanguageHint": false,
  "chat.tools.terminal.enableAutoApprove": false,
  "github.copilot.enable": {
    "*": false
  },
  "github.copilot.editor.enableCodeActions": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.nextEditSuggestions.fixes": false,
  "github.copilot.renameSuggestions.triggerAutomatically": false,

  // ==================== Other Tools & Accessibility ====================
  "accessibility.verbosity.inlineChat": false,
  "editor.accessibilitySupport": "off",
  "liveServer.settings.donotShowInfoMsg": true,
  "security.workspace.trust.untrustedFiles": "open",
  "animations.Enabled": true,
  "animations.Install-Method": "Custom UI Style",
  "vscode-pets.theme": "forest",
  "vscode-pets.throwBallWithMouse": true,
  "codesnap.backgroundColor": "#FFC540",
  "codesnap.containerPadding": "8em",
  "codesnap.boxShadow": "rgba(0, 0, 0, 0.55) 0px 12px 24px",
  "codesnap.roundedCorners": true,
  "codesnap.showLineNumbers": false,
  "peacock.favoriteColors": [
    {
      "name": "Angular Red",
      "value": "#dd0531"
    },
    {
      "name": "Azure Blue",
      "value": "#007fff"
    },
    {
      "name": "JavaScript Yellow",
      "value": "#f9e64f"
    },
    {
      "name": "Mandalorian Blue",
      "value": "#1857a4"
    },
    {
      "name": "Node Green",
      "value": "#215732"
    },
    {
      "name": "React Blue",
      "value": "#61dafb"
    },
    {
      "name": "Something Different",
      "value": "#832561"
    },
    {
      "name": "Svelte Orange",
      "value": "#ff3d00"
    },
    {
      "name": "Vue Green",
      "value": "#42b883"
    },
    {
      "name": "Django",
      "value": "#064B35"
    }
  ]
}
